{
  "manifest_version": 3,
  "key": "",
  "name": "GoDM Integration",
  "version": "1.0.0",
  "description": "Sends browser downloads to the GoDM download manager.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GoDM: click to turn capture on/off"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "godm@godm.local"
    }
  }
}
